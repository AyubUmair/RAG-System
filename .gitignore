# ==========================================
# 3. Vector DB, Embeddings & Data Storage
# ==========================================
# Ignore local Qdrant databases and vector storage
data/qdrant_db/
qdrant_storage/
storage/

# Ignore raw user documents and uploaded PDFs (keep the folder structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

